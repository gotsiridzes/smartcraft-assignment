              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('draftJobId', pm.response.json().id);",
                  "pm.collectionVariables.set('draftEtag', pm.response.headers.get('ETag'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Complete a job without lines (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "If-Match",
                "value": "{{draftEtag}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{draftJobId}}/complete"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Problem type is job-state-conflict', () => pm.expect(pm.response.json().type).to.match(/job-state-conflict$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid line (400 with field errors)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "If-Match",
                "value": "{{draftEtag}}"
              }
            ],
            "url": "{{baseUrl}}/jobs/{{draftJobId}}/lines",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Material\",\n  \"description\": \"Cable\",\n  \"quantity\": 0,\n  \"unitPrice\": 1.234\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
