          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Problem type is invalid-request', () => pm.expect(pm.response.json().type).to.match(/invalid-request$/));"
                ]
              }
            }
          ]
        },
        {
